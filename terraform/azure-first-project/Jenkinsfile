pipeline {
    agent any

    stages {
        stage('Terraform Format') {
            steps {
                dir('terraform/azure-first-project') {
                    sh 'terraform fmt -check -recursive'
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform/azure-first-project') {
                    sh 'terraform init -backend=false -input=false'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform/azure-first-project') {
                    sh 'terraform validate -no-color'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    string(credentialsId: 'azure-client-id', variable: 'ARM_CLIENT_ID'),
                    string(credentialsId: 'azure-client-secret', variable: 'ARM_CLIENT_SECRET'),
                    string(credentialsId: 'azure-subscription-id', variable: 'ARM_SUBSCRIPTION_ID'),
                    string(credentialsId: 'azure-tenant-id', variable: 'ARM_TENANT_ID'),
                    string(credentialsId: 'terraform-ssh-public-key', variable: 'TF_VAR_ssh_public_key')
                ]) {
                    dir('terraform/azure-first-project') {
                        sh 'terraform plan -input=false -no-color'
                    }
                }
            }
        }

        stage('Manual Approval') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input(
                        message: 'Revisa el resultado de Terraform Plan. Este laboratorio NO ejecutará terraform apply. ¿Confirmas la revisión?',
                        ok: 'Confirmar revisión'
                    )
                }

                echo 'Revisión aprobada. No se ha ejecutado terraform apply.'
            }
        }
    }

    post {
        success {
            echo 'Terraform pipeline completed successfully.'
        }

        failure {
            echo 'Terraform pipeline failed. Check the stage output.'
        }
    }
}
